DATABASE_URL=postgresql://mandate:mandate@127.0.0.1:5432/mandate
# Production API/worker/indexer/migration processes require the mounted RDS CA bundle path below.
# DATABASE_SSL_CA_PATH=/etc/mandate/certs/global-bundle.pem
MANDATE_JWT_JWKS_URL=https://identity.example.com/.well-known/jwks.json
MANDATE_JWT_ISSUER=https://identity.example.com/
MANDATE_JWT_AUDIENCE=mandate-api
# Hosted MCP OIDC must also accept tokens whose aud contains the MCP resource URL, e.g.:
# MANDATE_JWT_AUDIENCE=mandate-api,https://api.example.com/mcp
HOST=127.0.0.1
PORT=3000
MANDATE_WORKER_POLL_MS=1000
MANDATE_EVM_RPC_URLS={"10143":"https://rpc.example.invalid"}
# Optional ordered broadcaster backups; only exact caller-signed transaction bytes are retried.
MANDATE_BROADCAST_RPC_FALLBACK_URLS={}
# Optional per-chain indexer-only sequential fallbacks; every endpoint must report the configured chain ID.
MANDATE_INDEXER_RPC_FALLBACK_URLS={}
# Optional per-chain ordered read fallbacks for worker receipt reconciliation (max 3 per configured primary).
MANDATE_RECEIPT_RPC_FALLBACK_URLS={}
# Replace the sample with the chain's trusted Safe 1.5.0 singleton/proxy implementation address.
MANDATE_SAFE_SINGLETONS={"10143":"0x0000000000000000000000000000000000000001"}
MANDATE_CHAIN_CONFIRMATIONS={"10143":12}
MANDATE_INDEXER_START_BLOCKS={"10143":1}
MANDATE_INDEXER_CONFIRMATIONS=12
MANDATE_INDEXER_MAX_BLOCK_RANGE=100
MANDATE_INDEXER_POLL_MS=3000
DEEPSEEK_API_KEY=replace-with-a-local-only-key-or-leave-empty

# Optional signed audit exports. Store JSON {"keyId":"...","privateKeyPem":"-----BEGIN PRIVATE KEY-----\\n..."}
# in AWS Secrets Manager and grant only the API task role read access. Export requests return 503 when unset.
# MANDATE_AUDIT_SIGNING_SECRET_ARN=arn:aws:secretsmanager:region:account:secret:mandate/audit-signing-key

# Optional independent periodic audit anchoring (worker only). The target bucket must have
# versioning and S3 Object Lock enabled; configure governance externally and use COMPLIANCE
# retention. Keep the bucket independently administered from the Mandate database account.
# When enabled, the worker also requires MANDATE_AUDIT_SIGNING_SECRET_ARN above.
# MANDATE_AUDIT_ANCHOR_BUCKET=mandate-audit-anchors
# MANDATE_AUDIT_ANCHOR_RETENTION_DAYS=2555
# MANDATE_AUDIT_ANCHOR_INTERVAL_MS=60000
# MANDATE_AUDIT_ANCHOR_BATCH_SIZE=25

# Optional invitation mail: set the same random 32-byte key in secret manager for API + worker.
# Drain pending email jobs before rotating the key. Verify the SES sender before enabling.
# MANDATE_INVITATION_TOKEN_ENCRYPTION_KEY_HEX=replace-with-64-hex-character-secret
# MANDATE_INVITATION_EMAIL_FROM=invites@example.com
# MANDATE_INVITATION_ACCEPT_URL=https://console.example.com/invitations/accept

# OpenTelemetry is opt-in. For local Collector testing, set MANDATE_OTEL_ENABLED=true.
# Production collectors must use HTTPS; HTTP is accepted only for loopback development.
MANDATE_OTEL_ENABLED=false
MANDATE_OTEL_SAMPLE_RATIO=0.1
MANDATE_SERVICE_NAME=mandate-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# API rate limits are 120 requests per source IP per 60-second window by default.
# Production replicas must share one random key of at least 32 bytes; local development generates a process-local key.
# MANDATE_RATE_LIMIT_HMAC_KEY=replace-with-a-shared-random-32-byte-or-longer-secret
# When the API is reachable only through a trusted reverse proxy/ALB, set this to the proxy subnet CIDRs.
# Restrict the API security group to the proxy security group as well; never use catch-all CIDRs.
# MANDATE_TRUSTED_PROXY_CIDRS=10.20.1.0/24,10.20.2.0/24
# Optional exact browser origins for cross-origin frontend access to /api/v1.
# Origins must be HTTPS (HTTP loopback is allowed for local development); wildcards are rejected.
# Leave unset for same-origin deployments. No cookie credentials are enabled.
# MANDATE_CORS_ALLOWED_ORIGINS=https://console.example.com,https://staging-console.example.com

# Local MCP stdio connector: use an OIDC access token (or scoped agent bearer), never a model-provider key.
MANDATE_API_URL=http://127.0.0.1:3000
# Set in untracked .env.local; do not commit an access token.
# MANDATE_API_TOKEN=
# Optional for a human token with exactly one organization; required to select among several.
# MANDATE_ORGANIZATION_ID=

# Hosted MCP Streamable HTTP resource server (use an OIDC access token from the issuer above).
# MANDATE_MCP_RESOURCE_URL=https://api.example.com/mcp
# MANDATE_MCP_ALLOWED_ORIGINS=https://console.example.com
# MCP_PORT=3100
# Keep this process behind a TLS-terminating proxy on a private network.
