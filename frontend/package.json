{
  "name": "mandate-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "verify:api-contract": "node scripts/verify-api-contract.mjs",
    "test": "vitest run",
    "test:models:coverage": "vitest run tests/overview-metrics.test.ts tests/authorization-path-model.test.ts --coverage.enabled --coverage.include=src/app/overviewMetrics.ts --coverage.include=src/app/authorizationPathModel.ts --coverage.thresholds.lines=100 --coverage.thresholds.branches=100 --coverage.thresholds.functions=100 --coverage.thresholds.statements=100",
    "test:watch": "vitest",
    "lint": "oxlint src tests --deny-warnings"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@react-three/fiber": "^9.8.1",
    "motion": "^14.0.0",
    "oidc-client-ts": "^3.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.8.2",
    "three": "^0.186.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "jsdom": "^26.1.0",
    "oxlint": "^1.87.0",
    "typescript": "^5.9.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
